	boxTitle.TextXAlignment = Enum.TextXAlignment.Left
	boxTitle.Parent = textBoxContainer

	local inputBox = Instance.new("TextBox")
	inputBox.Size = UDim2.new(1, -30, 0, 28)
	inputBox.Position = UDim2.new(0, 15, 0, 30)
	inputBox.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
	inputBox.BackgroundTransparency = 0.5
	inputBox.BorderSizePixel = 0
	inputBox.Font = Enum.Font.SourceSans
	inputBox.PlaceholderText = placeholder or "พิมพ์ข้อความที่นี่..."
	inputBox.PlaceholderColor3 = Color3.fromRGB(150, 150, 150)
	inputBox.Text = ""
	inputBox.TextColor3 = Color3.fromRGB(255, 255, 255)
	inputBox.TextSize = 14
	inputBox.TextXAlignment = Enum.TextXAlignment.Left
	inputBox.Parent = textBoxContainer

	local ibCorner = Instance.new("UICorner")
	ibCorner.CornerRadius = UDim.new(0, 8)
	ibCorner.Parent = inputBox

	inputBox.FocusLost:Connect(function(enterPressed)
		if callback then callback(inputBox.Text, enterPressed) end
	end)
end
