function IOSLibrary:AddToggle(parentPage, title, defaultState, callback)
	local state = defaultState or false

	local toggleBox = Instance.new("Frame")
	toggleBox.Size = UDim2.new(1, -20, 0, 45)
	toggleBox.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
	toggleBox.BackgroundTransparency = 0.4
	toggleBox.BorderSizePixel = 0
	toggleBox.Parent = parentPage

	local tbCorner = Instance.new("UICorner")
	tbCorner.CornerRadius = UDim.new(0, 12)
	tbCorner.Parent = toggleBox

	-- เพิ่มเอฟเฟกต์กระจกเหลว (Glassmorphism Gradient)
	local toggleGradient = Instance.new("UIGradient")
	toggleGradient.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.1),
		NumberSequenceKeypoint.new(1, 0.4)
	})
	toggleGradient.Rotation = 45
	toggleGradient.Parent = toggleBox

	local toggleTitle = Instance.new("TextLabel")
	toggleTitle.Size = UDim2.new(1, -70, 1, 0)
	toggleTitle.Position = UDim2.new(0, 15, 0, 0)
	toggleTitle.BackgroundTransparency = 1
	toggleTitle.Font = Enum.Font.SourceSansBold
	toggleTitle.Text = title
	toggleTitle.TextColor3 = Color3.fromRGB(255, 255, 255)
	toggleTitle.TextSize = 14
	toggleTitle.TextXAlignment = Enum.TextXAlignment.Left
	toggleTitle.Parent = toggleBox

	local switchBg = Instance.new("TextButton")
	switchBg.Size = UDim2.new(0, 46, 0, 26)
	switchBg.Position = UDim2.new(1, -61, 0.5, -13)
	switchBg.BackgroundColor3 = state and Color3.fromRGB(52, 199, 89) or Color3.fromRGB(100, 100, 110)
	switchBg.AutoButtonColor = false
	switchBg.Text = ""
	switchBg.Parent = toggleBox

	local sbCorner = Instance.new("UICorner")
	sbCorner.CornerRadius = UDim.new(1, 0)
	sbCorner.Parent = switchBg

	local switchKnob = Instance.new("Frame")
	switchKnob.Size = UDim2.new(0, 22, 0, 22)
	switchKnob.AnchorPoint = Vector2.new(0, 0.5)
	switchKnob.Position = state and UDim2.new(1, -24, 0.5, 0) or UDim2.new(0, 2, 0.5, 0)
	switchKnob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	switchKnob.BorderSizePixel = 0
	switchKnob.Parent = switchBg

	local skCorner = Instance.new("UICorner")
	skCorner.CornerRadius = UDim.new(1, 0)
	skCorner.Parent = switchKnob

	switchBg.MouseButton1Click:Connect(function()
		state = not state
		
		local targetPos = state and UDim2.new(1, -24, 0.5, 0) or UDim2.new(0, 2, 0.5, 0)
		local targetColor = state and Color3.fromRGB(52, 199, 89) or Color3.fromRGB(100, 100, 110)

		TweenService:Create(switchBg, TweenInfo.new(0.25, Enum.EasingStyle.Quad), {BackgroundColor3 = targetColor}):Play()
		
		switchKnob:TweenPosition(targetPos, Enum.EasingDirection.Out, Enum.EasingStyle.Back, 0.3, true)
		
		TweenService:Create(switchKnob, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = UDim2.new(0, 26, 0, 18)}):Play()
		task.delay(0.12, function()
			TweenService:Create(switchKnob, TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = UDim2.new(0, 22, 0, 22)}):Play()
		end)

		if callback then callback(state) end
	end)
end

-- ==========================================
-- ฟังก์ชัน AddPlayerDropdown (ดึงรายชื่อผู้เล่นในเซิร์ฟเวอร์)
-- ==========================================
local TweenService = game:GetService("TweenService")

-- ==========================================
-- ฟังก์ชัน AddDropdown (สไตล์ Liquid Glass + Animation)
-- ==========================================
function IOSLibrary:AddDropdown(parentPage, title, options, callback)
	local isOpen = false
	local optionsList = options or {}
	local selectedOption = optionsList[1] or "เลือกตัวเลือก"

	-- หา ScreenGui หลักเพื่อลอย Popup เหนือทุกชั้น
	local screenGui = parentPage:FindFirstAncestorWhichIsA("ScreenGui") or parentPage

	-- ปุ่มเลือกหลักในหน้าต่าง
	local dropBox = Instance.new("Frame")
	dropBox.Size = UDim2.new(1, -20, 0, 45)
	dropBox.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	dropBox.BackgroundTransparency = 0.88 -- พื้นหลังใสบางเบา
	dropBox.BorderSizePixel = 0
	dropBox.Parent = parentPage

	local dbCorner = Instance.new("UICorner")
	dbCorner.CornerRadius = UDim.new(0, 12)
	dbCorner.Parent = dropBox

	local dbStroke = Instance.new("UIStroke")
	dbStroke.Color = Color3.fromRGB(255, 255, 255)
	dbStroke.Transparency = 0.75 -- ขอบกระจกใส
	dbStroke.Thickness = 0.8 -- ขอบบางเฉียบ
	dbStroke.Parent = dropBox

	local dropGradient = Instance.new("UIGradient")
	dropGradient.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.2),
		NumberSequenceKeypoint.new(1, 0.6)
	})
	dropGradient.Rotation = 45
	dropGradient.Parent = dropBox

	local selectBtn = Instance.new("TextButton")
	selectBtn.Size = UDim2.new(1, 0, 1, 0)
	selectBtn.BackgroundTransparency = 1
	selectBtn.Text = ""
	selectBtn.ZIndex = 5
	selectBtn.Parent = dropBox

	local psTitle = Instance.new("TextLabel")
	psTitle.Size = UDim2.new(1, -12, 0, 14)
	psTitle.Position = UDim2.new(0, 8, 0, 4)
	psTitle.BackgroundTransparency = 1
	psTitle.Font = Enum.Font.SourceSansBold
	psTitle.Text = "📌 " .. string.upper(title)
	psTitle.TextColor3 = Color3.fromRGB(180, 180, 190)
	psTitle.TextSize = 10
	psTitle.TextXAlignment = Enum.TextXAlignment.Left
	psTitle.ZIndex = 6
	psTitle.Parent = selectBtn

	local psValLabel = Instance.new("TextLabel")
	psValLabel.Size = UDim2.new(1, -12, 0, 20)
	psValLabel.Position = UDim2.new(0, 8, 0, 18)
	psValLabel.BackgroundTransparency = 1
	psValLabel.Font = Enum.Font.SourceSansBold
	psValLabel.Text = tostring(selectedOption) .. "  ↕"
	psValLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	psValLabel.TextSize = 13
	psValLabel.TextXAlignment = Enum.TextXAlignment.Left
	psValLabel.ZIndex = 6
	psValLabel.Parent = selectBtn

	-- Overlay ดักคลิกปิดเมื่อกดพื้นที่ว่าง
	local overlay = Instance.new("TextButton")
	overlay.Size = UDim2.new(1, 0, 1, 0)
	overlay.BackgroundTransparency = 1
	overlay.Text = ""
	overlay.AutoButtonColor = false
	overlay.Visible = false
	overlay.ZIndex = 9998
	overlay.Parent = screenGui

	-- ==================== Dropdown Flyout Panel (Liquid Glass) ====================
	local dropdownFlyout = Instance.new("CanvasGroup") -- รองรับ Fade / GroupTransparency
	dropdownFlyout.Size = UDim2.new(0, 180, 0, 130)
	dropdownFlyout.AnchorPoint = Vector2.new(0.5, 0.5)
	dropdownFlyout.Position = UDim2.new(0.5, 0, 0.48, 0)
	dropdownFlyout.BackgroundColor3 = Color3.fromRGB(20, 20, 30)
	dropdownFlyout.BackgroundTransparency = 0.35 -- กระจกใสโปร่งแสง
	dropdownFlyout.GroupTransparency = 1
	dropdownFlyout.BorderSizePixel = 0
	dropdownFlyout.Visible = false
	dropdownFlyout.ZIndex = 9999
	dropdownFlyout.Parent = screenGui

	local pdfCorner = Instance.new("UICorner")
	pdfCorner.CornerRadius = UDim.new(0, 16)
	pdfCorner.Parent = dropdownFlyout

	-- ขอบกระจกบางเฉียบ
	local pdfStroke = Instance.new("UIStroke")
	pdfStroke.Color = Color3.fromRGB(255, 255, 255)
	pdfStroke.Transparency = 0.65
	pdfStroke.Thickness = 0.8
	pdfStroke.Parent = dropdownFlyout

	-- เอฟเฟกต์สะท้อนแสงกระจกเหลว (Liquid Gloss Effect)
	local glassGradient = Instance.new("UIGradient")
	glassGradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(120, 130, 160))
	})
	glassGradient.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.15),
		NumberSequenceKeypoint.new(0.5, 0.4),
		NumberSequenceKeypoint.new(1, 0.7)
	})
	glassGradient.Rotation = 65
	glassGradient.Parent = dropdownFlyout

	local pdfHeader = Instance.new("Frame")
	pdfHeader.Size = UDim2.new(1, 0, 0, 32)
	pdfHeader.BackgroundTransparency = 1
	pdfHeader.ZIndex = 10000
	pdfHeader.Parent = dropdownFlyout

	local pdfHeaderIcon = Instance.new("TextLabel")
	pdfHeaderIcon.Size = UDim2.new(1, -20, 1, 0)
	pdfHeaderIcon.Position = UDim2.new(0, 12, 0, 0)
	pdfHeaderIcon.BackgroundTransparency = 1
	pdfHeaderIcon.Font = Enum.Font.SourceSansBold
	pdfHeaderIcon.Text = "📌 " .. title
	pdfHeaderIcon.TextColor3 = Color3.fromRGB(255, 255, 255)
	pdfHeaderIcon.TextSize = 13
	pdfHeaderIcon.TextXAlignment = Enum.TextXAlignment.Left
	pdfHeaderIcon.ZIndex = 10000
	pdfHeaderIcon.Parent = pdfHeader

	local pdfDivider1 = Instance.new("Frame")
	pdfDivider1.Size = UDim2.new(1, -20, 0, 1)
	pdfDivider1.Position = UDim2.new(0, 10, 0, 32)
	pdfDivider1.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	pdfDivider1.BackgroundTransparency = 0.85
	pdfDivider1.BorderSizePixel = 0
	pdfDivider1.ZIndex = 10000
	pdfDivider1.Parent = dropdownFlyout

	local pdfScroll = Instance.new("ScrollingFrame")
	pdfScroll.Size = UDim2.new(1, -8, 0, 85)
	pdfScroll.Position = UDim2.new(0, 4, 0, 36)
	pdfScroll.BackgroundTransparency = 1
	pdfScroll.BorderSizePixel = 0
	pdfScroll.CanvasSize = UDim2.new(0, 0, 0, 0)
	pdfScroll.ScrollBarThickness = 2
	pdfScroll.ZIndex = 10000
	pdfScroll.Parent = dropdownFlyout

	local pdfScrollLayout = Instance.new("UIListLayout")
	pdfScrollLayout.SortOrder = Enum.SortOrder.LayoutOrder
	pdfScrollLayout.Padding = UDim.new(0, 4)
	pdfScrollLayout.Parent = pdfScroll

	pdfScrollLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
		pdfScroll.CanvasSize = UDim2.new(0, 0, 0, pdfScrollLayout.AbsoluteContentSize.Y + 5)
	end)

	local pdfDivider2 = Instance.new("Frame")
	pdfDivider2.Size = UDim2.new(1, -20, 0, 1)
	pdfDivider2.Position = UDim2.new(0, 10, 0, 124)
	pdfDivider2.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	pdfDivider2.BackgroundTransparency = 0.85
	pdfDivider2.BorderSizePixel = 0
	pdfDivider2.ZIndex = 10000
	pdfDivider2.Parent = dropdownFlyout

	local pdfFooterBtn = Instance.new("TextButton")
	pdfFooterBtn.Size = UDim2.new(1, 0, 0, 32)
	pdfFooterBtn.Position = UDim2.new(0, 0, 0, 126)
	pdfFooterBtn.BackgroundTransparency = 1
	pdfFooterBtn.Font = Enum.Font.SourceSansBold
	pdfFooterBtn.Text = "ปิดหน้าต่าง"
	pdfFooterBtn.TextColor3 = Color3.fromRGB(255, 120, 120)
	pdfFooterBtn.TextSize = 12
	pdfFooterBtn.ZIndex = 10000
	pdfFooterBtn.Parent = dropdownFlyout

	-- ฟังก์ชันสำหรับสร้างรายการปุ่มตัวเลือก
	local function populateOptions()
		for _, child in ipairs(pdfScroll:GetChildren()) do
			if child:IsA("TextButton") then
				child:Destroy()
			end
		end

		for _, opt in ipairs(optionsList) do
			local btn = Instance.new("TextButton")
			btn.Size = UDim2.new(1, -6, 0, 30)
			btn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
			btn.BackgroundTransparency = 0.90 -- ใสเนียนกับแผงหลัก
			btn.AutoButtonColor = true
			btn.Font = Enum.Font.SourceSansBold
			btn.Text = "  " .. tostring(opt)
			btn.TextColor3 = Color3.fromRGB(240, 240, 255)
			btn.TextSize = 12
			btn.TextXAlignment = Enum.TextXAlignment.Left
			btn.ZIndex = 10001
			btn.Parent = pdfScroll

			local btnCorner = Instance.new("UICorner")
			btnCorner.CornerRadius = UDim.new(0, 8)
			btnCorner.Parent = btn

			local btnStroke = Instance.new("UIStroke")
			btnStroke.Color = Color3.fromRGB(255, 255, 255)
			btnStroke.Transparency = 0.85
			btnStroke.Thickness = 0.8
			btnStroke.Parent = btn

			btn.MouseButton1Click:Connect(function()
				selectedOption = opt
				psValLabel.Text = tostring(selectedOption) .. "  ↕"
				togglePopup(false)
				if callback then callback(opt) end
			end)
		end
	end

	-- ==================== ระบบอนิเมชั่น Liquid Bounce ====================
	local tweenInfoIn = TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	local tweenInfoOut = TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)

	function togglePopup(state)
		if state == nil then
			isOpen = not isOpen
		else
			isOpen = state
		end

		if isOpen then
			populateOptions()
			dropdownFlyout.Visible = true
			overlay.Visible = true

			-- จุดเริ่มต้นก่อนเล่นอนิเมชั่น (ย่อ + ลอยเล็กน้อย)
			dropdownFlyout.Size = UDim2.new(0, 180, 0, 130)
			dropdownFlyout.Position = UDim2.new(0.5, 0, 0.48, 0)
			dropdownFlyout.GroupTransparency = 1

			-- เล่นอนิเมชั่นขยายเด้งแบบนุ่มนวล
			TweenService:Create(dropdownFlyout, tweenInfoIn, {
				Size = UDim2.new(0, 220, 0, 165),
				Position = UDim2.new(0.5, 0, 0.5, 0),
				GroupTransparency = 0
			}):Play()
		else
			-- เล่นอนิเมชั่นยุบหายอย่างลื่นไหล
			local tweenClose = TweenService:Create(dropdownFlyout, tweenInfoOut, {
				Size = UDim2.new(0, 180, 0, 130),
				Position = UDim2.new(0.5, 0, 0.48, 0),
				GroupTransparency = 1
			})
			tweenClose:Play()
			tweenClose.Completed:Connect(function()
				if not isOpen then
					dropdownFlyout.Visible = false
					overlay.Visible = false
				end
			end)
		end
	end

	selectBtn.MouseButton1Click:Connect(function() togglePopup() end)
	overlay.MouseButton1Click:Connect(function() togglePopup(false) end)
	pdfFooterBtn.MouseButton1Click:Connect(function() togglePopup(false) end)
end


return IOSLibrary
