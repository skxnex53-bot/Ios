function IOSLibrary:AddSlider(parentPage, title, min, max, default, callback)
	local sliderBox = Instance.new("Frame")
	sliderBox.Size = UDim2.new(1, -20, 0, 65)
	sliderBox.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
	sliderBox.BackgroundTransparency = 0.4
	sliderBox.BorderSizePixel = 0
	sliderBox.Parent = parentPage

	local sbCorner = Instance.new("UICorner")
	sbCorner.CornerRadius = UDim.new(0, 12)
	sbCorner.Parent = sliderBox

	local sliderTitle = Instance.new("TextLabel")
	sliderTitle.Size = UDim2.new(0.6, 0, 0, 20)
	sliderTitle.Position = UDim2.new(0, 15, 0, 10)
	sliderTitle.BackgroundTransparency = 1
	sliderTitle.Font = Enum.Font.SourceSansBold
	sliderTitle.Text = title
	sliderTitle.TextColor3 = Color3.fromRGB(255, 255, 255)
	sliderTitle.TextSize = 14
	sliderTitle.TextXAlignment = Enum.TextXAlignment.Left
	sliderTitle.Parent = sliderBox

	local defaultPercent = math.clamp((default - min) / (max - min), 0, 1)

	local sliderValText = Instance.new("TextLabel")
	sliderValText.Size = UDim2.new(0.4, -15, 0, 20)
	sliderValText.Position = UDim2.new(0.6, 0, 0, 10)
	sliderValText.BackgroundTransparency = 1
	sliderValText.Font = Enum.Font.SourceSansBold
	sliderValText.Text = math.floor(default) .. "%"
	sliderValText.TextColor3 = Color3.fromRGB(100, 180, 255)
	sliderValText.TextSize = 14
	sliderValText.TextXAlignment = Enum.TextXAlignment.Right
	sliderValText.Parent = sliderBox

	local sliderTrack = Instance.new("Frame")
	sliderTrack.Size = UDim2.new(1, -30, 0, 8)
	sliderTrack.Position = UDim2.new(0, 15, 0, 42)
	sliderTrack.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
	sliderTrack.BorderSizePixel = 0
	sliderTrack.Parent = sliderBox

	local stCorner = Instance.new("UICorner")
	stCorner.CornerRadius = UDim.new(1, 0)
	stCorner.Parent = sliderTrack

	local sliderFill = Instance.new("Frame")
	sliderFill.Size = UDim2.new(defaultPercent, 0, 1, 0)
	sliderFill.BackgroundColor3 = Color3.fromRGB(52, 199, 89)
	sliderFill.BorderSizePixel = 0
	sliderFill.Parent = sliderTrack

	local sfCorner = Instance.new("UICorner")
	sfCorner.CornerRadius = UDim.new(1, 0)
	sfCorner.Parent = sliderFill

	local sliderKnob = Instance.new("Frame")
	sliderKnob.Size = UDim2.new(0, 18, 0, 18)
	sliderKnob.AnchorPoint = Vector2.new(0.5, 0.5)
	sliderKnob.Position = UDim2.new(defaultPercent, 0, 0.5, 0)
	sliderKnob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	sliderKnob.BorderSizePixel = 0
	sliderKnob.Parent = sliderTrack

	local skCorner = Instance.new("UICorner")
	skCorner.CornerRadius = UDim.new(1, 0)
	skCorner.Parent = sliderKnob

	local selfRef = self

	local function updateSlider(input)
		local pos = sliderTrack.AbsolutePosition.X
		local size = sliderTrack.AbsoluteSize.X
		local percent = math.clamp((input.Position.X - pos) / size, 0, 1)
		local value = min + (percent * (max - min))

		sliderFill.Size = UDim2.new(percent, 0, 1, 0)
		sliderKnob.Position = UDim2.new(percent, 0, 0.5, 0)
		sliderValText.Text = math.floor(value) .. "%"

		if callback then callback(value) end
	end

	sliderTrack.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			selfRef.isSliding = true
			selfRef:_setGuiInteractionActive(true)
			updateSlider(input)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			if selfRef.isSliding then
				selfRef.isSliding = false
				selfRef:_setGuiInteractionActive(false)
			end
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if selfRef.isSliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			updateSlider(input)
		end
	end)
end
	
