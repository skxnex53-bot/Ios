IOSLibrary.__index = IOSLibrary

function IOSLibrary.new(titleText)
	local self = setmetatable({}, IOSLibrary)
	
	self.dragging = false
	self.dragInput = nil
	self.dragStart = nil
	self.startPos = nil
	self.isSliding = false
	self.isOpen = false
	
	self.allMenuButtons = {}
	self.allPages = {}

	self.CAMERA_ACTION_NAME = "DisableCameraMovementDuringGUI_" .. math.random(1000, 9999)
	
	self.screenGui = Instance.new("ScreenGui")
	self.screenGui.Name = "IOSDashboardGui"
	self.screenGui.ResetOnSpawn = false
	self.screenGui.Parent = playerGui

	self.mainFrame = Instance.new("Frame")
	self.mainFrame.Name = "MainFrame"
	self.mainFrame.Size = UDim2.new(0, 520, 0, 320)
	self.mainFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
	self.mainFrame.AnchorPoint = Vector2.new(0.5, 0.5)
	self.mainFrame.BackgroundColor3 = Color3.fromRGB(28, 28, 35)
	self.mainFrame.BackgroundTransparency = 0.2
	self.mainFrame.BorderSizePixel = 0
	self.mainFrame.ClipsDescendants = false
	self.mainFrame.Visible = false
	self.mainFrame.Parent = self.screenGui

	local mainCorner = Instance.new("UICorner")
	mainCorner.CornerRadius = UDim.new(0, 20)
	mainCorner.Parent = self.mainFrame

	local mainStroke = Instance.new("UIStroke")
	mainStroke.Color = Color3.fromRGB(255, 255, 255)
	mainStroke.Transparency = 0.6
	mainStroke.Thickness = 1.2
	mainStroke.Parent = self.mainFrame

	self:_initDragging()
	self:_initGlassEffect()
	self:_initHeader(titleText)
	self:_initSidebarAndContent()

	return self
end

function IOSLibrary:_blockCamera(actionName, inputState, inputObject)
	return Enum.ContextActionResult.Sink
end

function IOSLibrary:_setGuiInteractionActive(active)
	if active then
		ContextActionService:BindActionAtPriority(
			self.CAMERA_ACTION_NAME,
			function(...) return self:_blockCamera(...) end,
			false,
			Enum.ContextActionPriority.High.Value,
			Enum.UserInputType.MouseButton1,
			Enum.UserInputType.Touch,
			Enum.UserInputType.MouseMovement
		)
	else
		ContextActionService:UnbindAction(self.CAMERA_ACTION_NAME)
	end
end

function IOSLibrary:_initDragging()
	local selfRef = self

	self.mainFrame.InputBegan:Connect(function(input)
		if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and not selfRef.isSliding then
			selfRef.dragging = true
			selfRef.dragStart = input.Position
			selfRef.startPos = selfRef.mainFrame.Position
			selfRef:_setGuiInteractionActive(true)
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then 
					selfRef.dragging = false 
					selfRef:_setGuiInteractionActive(false)
				end
			end)
		end
	end)

	self.mainFrame.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			selfRef.dragInput = input
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if input == selfRef.dragInput and selfRef.dragging and not selfRef.isSliding then
			local delta = input.Position - selfRef.dragStart
			selfRef.mainFrame.Position = UDim2.new(selfRef.startPos.X.Scale, selfRef.startPos.X.Offset + delta.X, selfRef.startPos.Y.Scale, selfRef.startPos.Y.Offset + delta.Y)
		end
	end)
end

function IOSLibrary:BindOpenButton(openButton)
	local selfRef = self

	openButton.MouseButton1Click:Connect(function()
		selfRef.isOpen = not selfRef.isOpen

		TweenService:Create(openButton, TweenInfo.new(0.1, Enum.EasingStyle.Quad), {Size = UDim2.new(0, 44, 0, 44)}):Play()
		task.delay(0.1, function()
			TweenService:Create(openButton, TweenInfo.new(0.1, Enum.EasingStyle.Quad), {Size = UDim2.new(0, 50, 0, 50)}):Play()
		end)

		if selfRef.isOpen then
			selfRef.mainFrame.Visible = true
			selfRef.mainFrame.Size = UDim2.new(0, 0, 0, 0)
			selfRef.mainFrame.BackgroundTransparency = 1

			TweenService:Create(selfRef.mainFrame, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
				Size = UDim2.new(0, 520, 0, 320),
				BackgroundTransparency = 0.2
			}):Play()
		else
			local closeTween = TweenService:Create(selfRef.mainFrame, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
				Size = UDim2.new(0, 0, 0, 0),
				BackgroundTransparency = 1
			})
			closeTween:Play()
			closeTween.Completed:Connect(function()
				if not selfRef.isOpen then selfRef.mainFrame.Visible = false end
			end)
		end
	end)
end

