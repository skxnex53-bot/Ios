function IOSLibrary:CreateTab(name, icon)
	local order = #self.allMenuButtons + 1

	local menuBtn = Instance.new("TextButton")
	menuBtn.Size = UDim2.new(1, -20, 0, 40)
	menuBtn.Position = UDim2.new(0, 10, 0, 0)
	menuBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
	menuBtn.BackgroundTransparency = (order == 1) and 0.3 or 0.8
	menuBtn.Text = (icon or "") .. "  " .. name
	menuBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	menuBtn.Font = Enum.Font.SourceSansSemibold
	menuBtn.TextSize = 15
	menuBtn.BorderSizePixel = 0
	menuBtn.LayoutOrder = order
	menuBtn.Parent = self.sidebar

	local mCorner = Instance.new("UICorner")
	mCorner.CornerRadius = UDim.new(0, 10)
	mCorner.Parent = menuBtn

	local page = Instance.new("ScrollingFrame")
	page.Size = UDim2.new(1, 0, 1, 0)
	page.BackgroundTransparency = 1
	page.BorderSizePixel = 0
	page.CanvasSize = UDim2.new(0, 0, 0, 0)
	page.ScrollBarThickness = 3
	page.Visible = (order == 1)
	page.Parent = self.contentArea

	local pageLayout = Instance.new("UIListLayout")
	pageLayout.SortOrder = Enum.SortOrder.LayoutOrder
	pageLayout.Padding = UDim.new(0, 10)
	pageLayout.Parent = page

	pageLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
		page.CanvasSize = UDim2.new(0, 0, 0, pageLayout.AbsoluteContentSize.Y + 20)
	end)

	table.insert(self.allMenuButtons, menuBtn)
	table.insert(self.allPages, page)

	local selfRef = self
	menuBtn.MouseButton1Click:Connect(function()
		for _, p in ipairs(selfRef.allPages) do
			p.Visible = (p == page)
		end
		for _, m in ipairs(selfRef.allMenuButtons) do
			TweenService:Create(m, TweenInfo.new(0.3, Enum.EasingStyle.Quad), {
				BackgroundTransparency = (m == menuBtn) and 0.3 or 0.8
			}):Play()
		end
	end)

	return page
end

