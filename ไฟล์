	popupCard.ClipsDescendants = true
	popupCard.Parent = parentPage

	local pcCorner = Instance.new("UICorner")
	pcCorner.CornerRadius = UDim.new(0, 16)
	pcCorner.Parent = popupCard

	local pcGradient = Instance.new("UIGradient")
	pcGradient.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.05),
		NumberSequenceKeypoint.new(1, 0.35)
	})
	pcGradient.Rotation = 45
	pcGradient.Parent = popupCard

	local pcStroke = Instance.new("UIStroke")
	pcStroke.Color = Color3.fromRGB(255, 255, 255)
	pcStroke.Transparency = 0.4
	pcStroke.Thickness = 1
	pcStroke.Parent = popupCard

	local popupHeader = Instance.new("TextLabel")
	popupHeader.Size = UDim2.new(1, 0, 0, 40)
	popupHeader.BackgroundTransparency = 1
	popupHeader.Font = Enum.Font.SourceSansBold
	popupHeader.Text = "📌  " .. title
	popupHeader.TextColor3 = Color3.fromRGB(255, 255, 255)
	popupHeader.TextSize = 16
	popupHeader.ZIndex = 101
	popupHeader.Parent = popupCard

	local headerDiv = Instance.new("Frame")
	headerDiv.Size = UDim2.new(1, 0, 0, 1)
	headerDiv.Position = UDim2.new(0, 0, 0, 40)
	headerDiv.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	headerDiv.BackgroundTransparency = 0.7
	headerDiv.BorderSizePixel = 0
	headerDiv.ZIndex = 101
	headerDiv.Parent = popupCard

	local scrollFrame = Instance.new("ScrollingFrame")
	scrollFrame.Size = UDim2.new(1, 0, 1, -50)
	scrollFrame.Position = UDim2.new(0, 0, 0, 41)
	scrollFrame.BackgroundTransparency = 1
	scrollFrame.BorderSizePixel = 0
	scrollFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
	scrollFrame.ScrollBarThickness = 2
	scrollFrame.ZIndex = 101
	scrollFrame.Parent = popupCard

	local scrollLayout = Instance.new("UIListLayout")
	scrollLayout.SortOrder = Enum.SortOrder.LayoutOrder
	scrollLayout.Padding = UDim.new(0, 4)
	scrollLayout.Parent = scrollFrame

	scrollLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
		scrollFrame.CanvasSize = UDim2.new(0, 0, 0, scrollLayout.AbsoluteContentSize.Y + 10)
	end)

	for _, opt in ipairs(options) do
		local btn = Instance.new("TextButton")
		btn.Size = UDim2.new(1, 0, 0, 40)
		btn.BackgroundTransparency = 1
		btn.BorderSizePixel = 0
		btn.ZIndex = 102
		btn.Parent = scrollFrame

		local nLabel = Instance.new("TextLabel")
		nLabel.Size = UDim2.new(1, -20, 1, 0)
		nLabel.Position = UDim2.new(0, 15, 0, 0)
		nLabel.BackgroundTransparency = 1
		nLabel.Font = Enum.Font.SourceSansBold
		nLabel.Text = tostring(opt)
		nLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
		nLabel.TextSize = 14
		nLabel.TextXAlignment = Enum.TextXAlignment.Left
		nLabel.ZIndex = 103
		nLabel.Parent = btn

		btn.MouseButton1Click:Connect(function()
			selectedOption = opt
			dropTitle.Text = "  📌  " .. title .. ": " .. selectedOption
			isOpen = false
			popupCard.Visible = false
			overlay.Visible = false
			arrowLabel.Text = "▾"
			if callback then callback(opt) end
		end)
	end

	local function togglePopup()
		isOpen = not isOpen
		popupCard.Visible = isOpen
		overlay.Visible = isOpen
		arrowLabel.Text = isOpen and "▴" or "▾"
	end

	dropTitle.MouseButton1Click:Connect(togglePopup)
	overlay.MouseButton1Click:Connect(togglePopup)
end


return IOSLibrary
