function NitroLibrary.new(titleText, iconId)
    local self = setmetatable({}, NitroLibrary)

    self.ScreenGui = Instance.new("ScreenGui")
    self.ScreenGui.Name = "NitroLibraryGui"
    self.ScreenGui.ResetOnSpawn = false
    self.ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    
    if syn and syn.protect_gui then
        syn.protect_gui(self.ScreenGui)
        self.ScreenGui.Parent = game.CoreGui
    elseif gethui then
        self.ScreenGui.Parent = gethui()
    else
        self.ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")
    end

    self.ToggleBtn = Instance.new("TextButton")
    self.ToggleBtn.Size = UDim2.new(0, 50, 0, 50)
    self.ToggleBtn.Position = UDim2.new(0, 20, 0, 150)
    self.ToggleBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
    self.ToggleBtn.BackgroundTransparency = 0.3
    self.ToggleBtn.Text = "GUI"
    self.ToggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    self.ToggleBtn.Font = Enum.Font.SourceSansBold
    self.ToggleBtn.TextSize = 14
    self.ToggleBtn.Parent = self.ScreenGui

    local tCorner = Instance.new("UICorner")
    tCorner.CornerRadius = UDim.new(0, 12)
    tCorner.Parent = self.ToggleBtn

    local tStroke = Instance.new("UIStroke")
    tStroke.Color = Color3.fromRGB(255, 255, 255)
    tStroke.Transparency = 0.7
    tStroke.Thickness = 1
    tStroke.Parent = self.ToggleBtn

    self.MainFrame = Instance.new("Frame")
    self.MainFrame.Size = UDim2.new(0, 520, 0, 340)
    self.MainFrame.Position = UDim2.new(0.5, -260, 0.5, -170)
    self.MainFrame.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
    self.MainFrame.BackgroundTransparency = 0.25
    self.MainFrame.BorderSizePixel = 0
    self.MainFrame.ClipsDescendants = true
    self.MainFrame.Parent = self.ScreenGui

    local mCorner = Instance.new("UICorner")
    mCorner.CornerRadius = UDim.new(0, 16)
    mCorner.Parent = self.MainFrame

    local mStroke = Instance.new("UIStroke")
    mStroke.Color = Color3.fromRGB(255, 255, 255)
    mStroke.Transparency = 0.7
    mStroke.Thickness = 1
    mStroke.Parent = self.MainFrame

    self.TopBar = Instance.new("Frame")
    self.TopBar.Size = UDim2.new(1, 0, 0, 35)
    self.TopBar.BackgroundTransparency = 1
    self.TopBar.Parent = self.MainFrame

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, 0, 1, 0)
    title.BackgroundTransparency = 1
    title.Font = Enum.Font.SourceSansBold
    title.Text = titleText or "Nitro"
    title.TextColor3 = Color3.fromRGB(255, 255, 255)
    title.TextSize = 15
    title.Parent = self.TopBar

    local function createMacBtn(color, xPos)
        local btn = Instance.new("Frame")
        btn.Size = UDim2.new(0, 12, 0, 12)
        btn.Position = UDim2.new(0, xPos, 0, 11)
        btn.BackgroundColor3 = color
        btn.BorderSizePixel = 0
        btn.Parent = self.TopBar
        local c = Instance.new("UICorner")
        c.CornerRadius = UDim.new(1, 0)
        c.Parent = btn
        return btn
    end
    createMacBtn(Color3.fromRGB(255, 95, 86), 15)
    createMacBtn(Color3.fromRGB(255, 189, 46), 35)
    createMacBtn(Color3.fromRGB(39, 201, 63), 55)

    self.Sidebar = Instance.new("ScrollingFrame")
    self.Sidebar.Size = UDim2.new(0, 130, 1, -45)
    self.Sidebar.Position = UDim2.new(0, 10, 0, 40)
    self.Sidebar.BackgroundTransparency = 1
    self.Sidebar.BorderSizePixel = 0
    self.Sidebar.CanvasSize = UDim2.new(0, 0, 0, 0)
    self.Sidebar.AutomaticCanvasSize = Enum.AutomaticSize.Y
    self.Sidebar.ScrollBarThickness = 0
    self.Sidebar.Parent = self.MainFrame

    local sideLayout = Instance.new("UIListLayout")
    sideLayout.SortOrder = Enum.SortOrder.LayoutOrder
    sideLayout.Padding = UDim.new(0, 6)
    sideLayout.Parent = self.Sidebar

    self.PagesContainer = Instance.new("Frame")
    self.PagesContainer.Size = UDim2.new(1, -155, 1, -45)
    self.PagesContainer.Position = UDim2.new(0, 145, 0, 40)
    self.PagesContainer.BackgroundTransparency = 1
    self.PagesContainer.Parent = self.MainFrame

    self.Tabs = {}
    self.Pages = {}

    local isOpen = true
    self.ToggleBtn.MouseButton1Click:Connect(function()
        isOpen = not isOpen
        self.MainFrame.Visible = isOpen
    end)

    local dragging, dragStart, startPos
    self.TopBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = self.MainFrame.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            self.MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    return self
end

function NitroLibrary:AddTab(order, name, emoji)
    local tabBtn = Instance.new("TextButton")
    tabBtn.Size = UDim2.new(1, 0, 0, 36)
    tabBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
    tabBtn.BackgroundTransparency = 0.6
    tabBtn.Text = "   " .. (emoji or "") .. "  " .. name
    tabBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
    tabBtn.Font = Enum.Font.SourceSansBold
    tabBtn.TextSize = 14
    tabBtn.TextXAlignment = Enum.TextXAlignment.Left
    tabBtn.LayoutOrder = order
    tabBtn.Parent = self.Sidebar

    local tbCorner = Instance.new("UICorner")
    tbCorner.CornerRadius = UDim.new(0, 10)
    tbCorner.Parent = tabBtn

    local page = Instance.new("ScrollingFrame")
    page.Size = UDim2.new(1, 0, 1, 0)
    page.BackgroundTransparency = 1
    page.BorderSizePixel = 0
    page.CanvasSize = UDim2.new(0, 0, 0, 0)
    page.AutomaticCanvasSize = Enum.AutomaticSize.Y
    page.ScrollBarThickness = 3
    page.Visible = false
    page.Parent = self.PagesContainer

    local pageLayout = Instance.new("UIListLayout")
    pageLayout.SortOrder = Enum.SortOrder.LayoutOrder
    pageLayout.Padding = UDim.new(0, 8)
    pageLayout.Parent = page

    table.insert(self.Pages, page)

    tabBtn.MouseButton1Click:Connect(function()
        for _, p in pairs(self.Pages) do p.Visible = false end
        page.Visible = true
    end)

    if #self.Pages == 1 then
        page.Visible = true
    end

    return page
end
