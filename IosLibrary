    boxContainer.Position = UDim2.new(0.5, 0, 0.5, -18)
    boxContainer.BackgroundColor3 = Color3.fromRGB(28, 28, 35)
    boxContainer.BackgroundTransparency = 0.5
    boxContainer.BorderSizePixel = 0
    boxContainer.Parent = row

    local bcCorner = Instance.new("UICorner")
    bcCorner.CornerRadius = UDim.new(0, 8)
    bcCorner.Parent = boxContainer

    local bcStroke = Instance.new("UIStroke")
    bcStroke.Color = Color3.fromRGB(255, 255, 255)
    bcStroke.Transparency = 0.85
    bcStroke.Thickness = 1
    bcStroke.Parent = boxContainer

    local box = Instance.new("TextBox")
    box.Size = UDim2.new(1, -16, 1, 0)
    box.Position = UDim2.new(0, 8, 0, 0)
    box.BackgroundTransparency = 1
    box.PlaceholderText = placeholder or "กรอกข้อมูล..."
    box.Text = ""
    box.TextColor3 = Color3.fromRGB(255, 255, 255)
    box.PlaceholderColor3 = Color3.fromRGB(140, 140, 150)
    box.Font = Enum.Font.SourceSans
    box.TextSize = 14
    box.TextXAlignment = Enum.TextXAlignment.Left
    box.ClearTextOnFocus = false
    box.Parent = boxContainer

    box.Focused:Connect(function()
        TweenService:Create(boxContainer, TweenInfo.new(0.25, Enum.EasingStyle.Quad), {BackgroundTransparency = 0.2}):Play()
        TweenService:Create(bcStroke, TweenInfo.new(0.25, Enum.EasingStyle.Quad), {
            Transparency = 0.2,
            Color = Color3.fromRGB(0, 122, 255)
        }):Play()
    end)

    box.FocusLost:Connect(function(enterPressed)
        TweenService:Create(boxContainer, TweenInfo.new(0.25, Enum.EasingStyle.Quad), {BackgroundTransparency = 0.5}):Play()
        TweenService:Create(bcStroke, TweenInfo.new(0.25, Enum.EasingStyle.Quad), {
            Transparency = 0.85,
            Color = Color3.fromRGB(255, 255, 255)
        }):Play()
        if callback then callback(box.Text, enterPressed) end
    end)
end

function NitroLibrary:AddDropdown(page, text, emoji, options, callback)
    local isOpen = false
    local baseHeight = 50
    local itemHeight = 35
    local maxDisplay = #options * itemHeight

    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, -20, 0, baseHeight)
    row.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
    row.BackgroundTransparency = 0.4
    row.BorderSizePixel = 0
    row.ClipsDescendants = true
    row.Parent = page

    local rCorner = Instance.new("UICorner")
    rCorner.CornerRadius = UDim.new(0, 12)
    rCorner.Parent = row

    local rStroke = Instance.new("UIStroke")
    rStroke.Color = Color3.fromRGB(255, 255, 255)
    rStroke.Transparency = 0.8
    rStroke.Thickness = 1
    rStroke.Parent = row

    local dropBtn = Instance.new("TextButton")
    dropBtn.Size = UDim2.new(1, 0, 0, 50)
    dropBtn.BackgroundTransparency = 1
    dropBtn.Text = ""
    dropBtn.Parent = row

    local rowLabel = Instance.new("TextLabel")
    rowLabel.Size = UDim2.new(0.7, 0, 0, 50)
    rowLabel.Position = UDim2.new(0, 15, 0, 0)
    rowLabel.BackgroundTransparency = 1
    rowLabel.Font = Enum.Font.SourceSansBold
    rowLabel.Text = emoji .. "  " .. text
    rowLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    rowLabel.TextSize = 15
    rowLabel.TextXAlignment = Enum.TextXAlignment.Left
    rowLabel.Parent = dropBtn

    local arrowLabel = Instance.new("TextLabel")
    arrowLabel.Size = UDim2.new(0, 30, 0, 50)
    arrowLabel.Position = UDim2.new(1, -40, 0, 0)
    arrowLabel.BackgroundTransparency = 1
    arrowLabel.Font = Enum.Font.SourceSansBold
    arrowLabel.Text = "▼"
    arrowLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
    arrowLabel.TextSize = 14
    arrowLabel.Parent = dropBtn

    local container = Instance.new("Frame")
    container.Size = UDim2.new(1, -20, 0, maxDisplay)
    container.Position = UDim2.new(0, 10, 0, 52)
    container.BackgroundTransparency = 1
    container.Parent = row

    local cLayout = Instance.new("UIListLayout")
    cLayout.SortOrder = Enum.SortOrder.LayoutOrder
    cLayout.Padding = UDim.new(0, 4)
    cLayout.Parent = container

    for _, opt in ipairs(options) do
        local optBtn = Instance.new("TextButton")
        optBtn.Size = UDim2.new(1, 0, 0, 32)
        optBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
        optBtn.BackgroundTransparency = 0.5
        optBtn.Text = "  " .. opt
        optBtn.TextColor3 = Color3.fromRGB(220, 220, 230)
        optBtn.Font = Enum.Font.SourceSansSemibold
        optBtn.TextSize = 14
        optBtn.TextXAlignment = Enum.TextXAlignment.Left
        optBtn.BorderSizePixel = 0
        optBtn.Parent = container

        local oCorner = Instance.new("UICorner")
        oCorner.CornerRadius = UDim.new(0, 8)
        oCorner.Parent = optBtn

        optBtn.MouseButton1Click:Connect(function()
            isOpen = false
            TweenService:Create(row, TweenInfo.new(0.2), {Size = UDim2.new(1, -20, 0, baseHeight)}):Play()
            TweenService:Create(arrowLabel, TweenInfo.new(0.2), {Rotation = 0}):Play()
            if callback then callback(opt) end
        end)
    end

    dropBtn.MouseButton1Click:Connect(function()
        isOpen = not isOpen
        local targetH = isOpen and (baseHeight + maxDisplay + 10) or baseHeight
        local targetRot = isOpen and 180 or 0
        TweenService:Create(row, TweenInfo.new(0.25, Enum.EasingStyle.Quad), {Size = UDim2.new(1, -20, 0, targetH)}):Play()
        TweenService:Create(arrowLabel, TweenInfo.new(0.25), {Rotation = targetRot}):Play()
    end)
end

