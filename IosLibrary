function NitroLibrary.new(customTitle, openButtonImage)
    local self = setmetatable({}, NitroLibrary)
    self.TitleText = customTitle or "Nitro"
    self.AllMenuButtons = {}
    self.AllPages = {}

    self.ScreenGui = Instance.new("ScreenGui")
    self.ScreenGui.Name = "IOSDashboardGui"
    self.ScreenGui.ResetOnSpawn = false
    self.ScreenGui.Parent = playerGui

    self.OpenButton = Instance.new("ImageButton")
    self.OpenButton.Name = "OpenButton"
    self.OpenButton.Size = UDim2.new(0, 50, 0, 50)
    self.OpenButton.Position = UDim2.new(0, 30, 0.4, 0)
    self.OpenButton.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
    self.OpenButton.BackgroundTransparency = 0.2
    self.OpenButton.Image = openButtonImage or ""
    self.OpenButton.BorderSizePixel = 0
    self.OpenButton.Parent = self.ScreenGui

    local openBtnCorner = Instance.new("UICorner")
    openBtnCorner.CornerRadius = UDim.new(0, 12)
    openBtnCorner.Parent = self.OpenButton

    local openBtnStroke = Instance.new("UIStroke")
    openBtnStroke.Color = Color3.fromRGB(255, 255, 255)
    openBtnStroke.Transparency = 0.5
    openBtnStroke.Thickness = 1.5
    openBtnStroke.Parent = self.OpenButton

    self.MainFrame = Instance.new("Frame")
    self.MainFrame.Name = "MainFrame"
    self.MainFrame.Size = UDim2.new(0, 520, 0, 320)
    self.MainFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
    self.MainFrame.AnchorPoint = Vector2.new(0.5, 0.5)
    self.MainFrame.BackgroundColor3 = Color3.fromRGB(28, 28, 35)
    self.MainFrame.BackgroundTransparency = 0.2
    self.MainFrame.BorderSizePixel = 0
    self.MainFrame.ClipsDescendants = true
    self.MainFrame.Visible = false
    self.MainFrame.Parent = self.ScreenGui

    local mainCorner = Instance.new("UICorner")
    mainCorner.CornerRadius = UDim.new(0, 20)
    mainCorner.Parent = self.MainFrame

    local mainStroke = Instance.new("UIStroke")
    mainStroke.Color = Color3.fromRGB(255, 255, 255)
    mainStroke.Transparency = 0.6
    mainStroke.Thickness = 1.2
    mainStroke.Parent = self.MainFrame

    local dragging, dragStart, startPos
    local btnDragging, btnDragStart, btnStartPos

    self.OpenButton.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            btnDragging = true
            btnDragStart = input.Position
            btnStartPos = self.OpenButton.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then btnDragging = false end
            end)
        end
    end)

    self.MainFrame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = self.MainFrame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            if btnDragging then
                local delta = input.Position - btnDragStart
                self.OpenButton.Position = UDim2.new(btnStartPos.X.Scale, btnStartPos.X.Offset + delta.X, btnStartPos.Y.Scale, btnStartPos.Y.Offset + delta.Y)
            elseif dragging then
                local delta = input.Position - dragStart
                self.MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            end
        end
    end)

    local isOpen = false
    self.OpenButton.MouseButton1Click:Connect(function()
        if btnDragging then return end
        isOpen = not isOpen
        
        TweenService:Create(self.OpenButton, TweenInfo.new(0.1, Enum.EasingStyle.Quad), {Size = UDim2.new(0, 44, 0, 44)}):Play()
        task.delay(0.1, function()
            TweenService:Create(self.OpenButton, TweenInfo.new(0.1, Enum.EasingStyle.Quad), {Size = UDim2.new(0, 50, 0, 50)}):Play()
        end)

        if isOpen then
            self.MainFrame.Visible = true
            self.MainFrame.Size = UDim2.new(0, 0, 0, 0)
            self.MainFrame.BackgroundTransparency = 1
            
            TweenService:Create(self.MainFrame, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                Size = UDim2.new(0, 520, 0, 320),
                BackgroundTransparency = 0.2
            }):Play()
        else
            local closeTween = TweenService:Create(self.MainFrame, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
                Size = UDim2.new(0, 0, 0, 0),
                BackgroundTransparency = 1
            })
            closeTween:Play()
            closeTween.Completed:Connect(function()
                if not isOpen then self.MainFrame.Visible = false end
            end)
        end
    end)

    local glassGradient = Instance.new("UIGradient")
    glassGradient.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.15),
        NumberSequenceKeypoint.new(0.5, 0.6),
        NumberSequenceKeypoint.new(1, 0.2)
    })
    glassGradient.Rotation = 45
    glassGradient.Parent = self.MainFrame

    local headerFrame = Instance.new("Frame")
    headerFrame.Size = UDim2.new(1, 0, 0, 45)
    headerFrame.BackgroundTransparency = 1
    headerFrame.Parent = self.MainFrame

    local dotsContainer = Instance.new("Frame")
    dotsContainer.Size = UDim2.new(0, 70, 0, 45)
    dotsContainer.Position = UDim2.new(0, 15, 0, 0)
    dotsContainer.BackgroundTransparency = 1
    dotsContainer.Parent = headerFrame

    local dotsLayout = Instance.new("UIListLayout")
    dotsLayout.FillDirection = Enum.FillDirection.Horizontal
    dotsLayout.HorizontalAlignment = Enum.HorizontalAlignment.Left
    dotsLayout.VerticalAlignment = Enum.VerticalAlignment.Center
    dotsLayout.SortOrder = Enum.SortOrder.LayoutOrder
    dotsLayout.Padding = UDim.new(0, 6)
    dotsLayout.Parent = dotsContainer

    local function createStaticDot(order, color)
        local dot = Instance.new("Frame")
        dot.Size = UDim2.new(0, 12, 0, 12)
        dot.BackgroundColor3 = color
        dot.BorderSizePixel = 0
        dot.LayoutOrder = order
        dot.Parent = dotsContainer

        local dotCorner = Instance.new("UICorner")
        dotCorner.CornerRadius = UDim.new(1, 0)
        dotCorner.Parent = dot
    end

    createStaticDot(1, Color3.fromRGB(255, 95, 86))
    createStaticDot(2, Color3.fromRGB(255, 189, 46))
    createStaticDot(3, Color3.fromRGB(39, 201, 63))

    local nitroLabel = Instance.new("TextLabel")
    nitroLabel.Size = UDim2.new(1, -100, 1, 0)
    nitroLabel.Position = UDim2.new(0, 95, 0, 0)
    nitroLabel.BackgroundTransparency = 1
    nitroLabel.Font = Enum.Font.SourceSansBold
    nitroLabel.Text = self.TitleText
    nitroLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    nitroLabel.TextSize = 20
    nitroLabel.TextXAlignment = Enum.TextXAlignment.Left
    nitroLabel.Parent = headerFrame

    local headerDivider = Instance.new("Frame")
    headerDivider.Size = UDim2.new(1, 0, 0, 1)
    headerDivider.Position = UDim2.new(0, 0, 0, 45)
    headerDivider.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    headerDivider.BackgroundTransparency = 0.7
    headerDivider.BorderSizePixel = 0
    headerDivider.Parent = self.MainFrame

    self.Sidebar = Instance.new("ScrollingFrame")
    self.Sidebar.Size = UDim2.new(0, 140, 1, -46)
    self.Sidebar.Position = UDim2.new(0, 0, 0, 46)
    self.Sidebar.BackgroundTransparency = 1
    self.Sidebar.BorderSizePixel = 0
    self.Sidebar.CanvasSize = UDim2.new(0, 0, 0, 200)
    self.Sidebar.ScrollBarThickness = 2
    self.Sidebar.Parent = self.MainFrame

    local sidebarLayout = Instance.new("UIListLayout")
    sidebarLayout.SortOrder = Enum.SortOrder.LayoutOrder
    sidebarLayout.Padding = UDim.new(0, 8)
    sidebarLayout.Parent = self.Sidebar

    local verticalDivider = Instance.new("Frame")
    verticalDivider.Size = UDim2.new(0, 1, 1, -46)
    verticalDivider.Position = UDim2.new(0, 140, 0, 46)
    verticalDivider.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    verticalDivider.BackgroundTransparency = 0.7
    verticalDivider.BorderSizePixel = 0
    verticalDivider.Parent = self.MainFrame

    self.ContentArea = Instance.new("Frame")
    self.ContentArea.Size = UDim2.new(1, -141, 1, -46)
    self.ContentArea.Position = UDim2.new(0, 141, 0, 46)
    self.ContentArea.BackgroundTransparency = 1
    self.ContentArea.ClipsDescendants = true
    self.ContentArea.Parent = self.MainFrame

    return self
end

function NitroLibrary:AddTab(order, menuName, emojiIcon)
    local menuBtn = Instance.new("TextButton")
    menuBtn.Size = UDim2.new(1, -20, 0, 40)
    menuBtn.Position = UDim2.new(0, 10, 0, 0)
    menuBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
    menuBtn.BackgroundTransparency = 0.8
    menuBtn.Text = emojiIcon .. "  " .. menuName
    menuBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    menuBtn.Font = Enum.Font.SourceSansSemibold
    menuBtn.TextSize = 15
    menuBtn.BorderSizePixel = 0
    menuBtn.LayoutOrder = order
    menuBtn.Parent = self.Sidebar

    local mCorner = Instance.new("UICorner")
    mCorner.CornerRadius = UDim.new(0, 10)
    mCorner.Parent = menuBtn

    local page = Instance.new("ScrollingFrame")
    page.Size = UDim2.new(1, 0, 1, 0)
    page.Position = UDim2.new(0, 0, 0, 0)
    page.BackgroundTransparency = 1
    page.BorderSizePixel = 0
    page.CanvasSize = UDim2.new(0, 0, 0, 0)
    page.AutomaticCanvasSize = Enum.AutomaticSize.Y
    page.ScrollBarThickness = 3
    page.Visible = false
    page.Parent = self.ContentArea

    local pageLayout = Instance.new("UIListLayout")
    pageLayout.SortOrder = Enum.SortOrder.LayoutOrder
    pageLayout.Padding = UDim.new(0, 10)
    pageLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    pageLayout.Parent = page

    local pagePadding = Instance.new("UIPadding")
    pagePadding.PaddingTop = UDim.new(0, 12)
    pagePadding.PaddingBottom = UDim.new(0, 12)
    pagePadding.Parent = page

    table.insert(self.AllMenuButtons, menuBtn)
    table.insert(self.AllPages, page)

    menuBtn.MouseButton1Click:Connect(function()
        for i, p in ipairs(self.AllPages) do
            p.Visible = (p == page)
        end
        for i, m in ipairs(self.AllMenuButtons) do
            TweenService:Create(m, TweenInfo.new(0.3, Enum.EasingStyle.Quad), {BackgroundTransparency = (m == menuBtn) and 0.3 or 0.8}):Play()
        end
    end)

    return page
end
